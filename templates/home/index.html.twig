{% extends 'base.html.twig' %}

{% block title %}Bienvenue{% endblock %}

{% block body %}
<div class="container text-center mt-5">
    <h1 class="mb-4">Bienvenue{% if app.user %}, {{ app.user.pseudo }}{% endif %} !</h1>

    <p class="lead">
        {% if app.user %}
            Prêt à explorer ou publier des articles ? 🚀
        {% else %}
            Connecte-toi ou crée un compte pour commencer !
        {% endif %}
    </p>

    <div class="mt-4">
        <a href="{{ path('app_post_index') }}" class="btn btn-primary btn-lg me-2">📚 Voir les posts</a>

        {% if not app.user %}
            <a href="{{ path('app_login') }}" class="btn btn-outline-secondary btn-lg me-2">Se connecter</a>
            <a href="{{ path('app_register') }}" class="btn btn-success btn-lg">Créer un compte</a>
        {% else %}
        <a class="btn btn-secondary btn-lg me-2" href="{{ path('app_post_new') }}">Créer un nouvel article</a>

            <!-- <a href="{{ path('app_logout') }}" class="btn btn-danger btn-lg">Se déconnecter</a> -->
        {% endif %}
    </div>
    <h2 class="mt-5 mb-3">🆕 Derniers posts</h2>
<div class="row">
    {% for post in latest_posts %}
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">{{ post.title }}</h5>
                    <p class="card-text">{{ post.content[:100] ~ '...' }}</p>
                    <a href="{{ path('app_post_show', {id: post.id}) }}" class="btn btn-sm btn-outline-primary">Lire</a>
                </div>
            </div>
        </div>
    {% else %}
        <p>Aucun post pour le moment.</p>
    {% endfor %}
</div>

</div>
{% endblock %}
