{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}
    <h1 class="mb-4">📰 Tous les articles</h1>

    <div class="row">
        {% for post in posts %}
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">{{ post.title }}</h5>
                        <p class="card-text">{{ post.content[:120] ~ '...' }}</p>
                        <small class="text-muted">Par {{ post.author.pseudo }} - le {{ post.createdAt|date('d/m/Y H:i') }}</small>
                        <div class="mt-3">
                            <a href="{{ path('app_post_show', {'id': post.id}) }}" class="btn btn-sm btn-outline-primary">Lire</a>

                            {% if app.user %}
                                {% if post.author == app.user %}
                                    <!-- Afficher le bouton "Modifier" si l'utilisateur est l'auteur -->
                                    <a href="{{ path('app_post_edit', {'id': post.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                                    <!-- Afficher le bouton "Supprimer" si l'utilisateur est l'auteur -->
                                    <form action="{{ path('app_post_delete', {'id': post.id}) }}" method="POST" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                    </form>
                                {% elseif 'ROLE_ADMIN' in app.user.roles %}
                                    <!-- Afficher le bouton "Modifier" et "Supprimer" si l'utilisateur est admin -->
                                    <a href="{{ path('app_post_edit', {'id': post.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                                    <form action="{{ path('app_post_delete', {'id': post.id}) }}" method="POST" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                    </form>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun post n’a été publié pour le moment.</p>
        {% endfor %}
    </div>

    <div class="d-flex justify-content-center mt-4">
        {{ knp_pagination_render(posts) }}
    </div>

    <!-- Ajout du bouton de retour à la page d'accueil -->
    <div class="d-flex justify-content-center mt-4">
        <a href="{{ path('app_home') }}" class="btn btn-primary">Retour à l'accueil</a>
    </div>
{% endblock %}
